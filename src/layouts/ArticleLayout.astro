---
import BaseLayout from './BaseLayout.astro';
import RepositoryCTA from '../components/RepositoryCTA.astro';
import { formatArticleDate } from '../utils/dates';
import { getUiDictionary, type Locale } from '../i18n/config';
import type { LocalePathSuffix } from '../utils/alternates';
import type { Article } from '../utils/articles';
import type { NavItem } from '../utils/navigation';

interface Props {
  article: Article;
  locale: Locale;
  /** Localized navigation for the article's language tree. */
  navItems: NavItem[];
  /** hreflang cluster of the article's published language versions. */
  alternates?: LocalePathSuffix[];
  /** Visible language switcher links (published versions only). */
  languageSwitcher?: LocalePathSuffix[];
}

const { article, locale, navItems, alternates = [], languageSwitcher } = Astro.props;
const { data } = article;
const strings = getUiDictionary(locale);

const publishedAt = formatArticleDate(data.publishedAt, locale);

const updatedAt = data.updatedAt?.toISOString() ?? null;

const updatedAtFormatted = data.updatedAt
  ? formatArticleDate(data.updatedAt, locale)
  : null;
---

<BaseLayout
  title={data.title}
  description={data.description}
  ogType="article"
  publishedTime={data.publishedAt}
  modifiedTime={data.updatedAt ?? undefined}
  lang={locale}
  navItems={navItems}
  alternates={alternates}
  languageSwitcher={languageSwitcher}
>
  <article>
    <header class="article-header">
      <h1>{data.title}</h1>
      <p>{data.description}</p>
      <p class="article-meta">
        {strings.publishedLabel} <time datetime={data.publishedAt.toISOString()}>{publishedAt}</time>
        {updatedAt && (
          <span>
            {' · '}{strings.updatedLabel} <time datetime={updatedAt}>{updatedAtFormatted}</time>
          </span>
        )}
        {data.pillar.length > 0 && (
          <span>
            {' · '}
            {data.pillar.map((pillar) => (
              <span class="pillar">{pillar}</span>
            ))}
          </span>
        )}
      </p>
    </header>
    <slot />
    <footer>
      {data.repositoryUrl && <RepositoryCTA url={data.repositoryUrl} locale={locale} />}
      {data.releaseUrl && (
        <p><a href={data.releaseUrl} rel="noopener noreferrer">{strings.viewRelease}</a></p>
      )}
      {data.evidenceUrl && (
        <p><a href={data.evidenceUrl} rel="noopener noreferrer">{strings.viewEvidenceReport}</a></p>
      )}
    </footer>
  </article>
</BaseLayout>
