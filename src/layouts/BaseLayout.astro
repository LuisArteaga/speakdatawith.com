---
// Self-hosted webfonts (no CDN); per-weight CSS files bundled by Vite.
import '@fontsource/fira-code/400.css';
import '@fontsource/fira-code/600.css';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
// Design tokens must load before the structural base styles.
import '../styles/tokens.css';
import '../styles/global.css';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { buildOgMetadata, buildPageTitle, SITE_NAME } from '../utils/og';
import { buildNavItems, isNoindexPagePath } from '../utils/navigation';
import { getUiDictionary, type Locale } from '../i18n/config';
import type { LocalePathSuffix } from '../utils/alternates';
import type { NavItem } from '../utils/navigation';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  /**
   * Site language of the page. Omitted only on the shared root pages that
   * keep their current English chrome (the 404 page must stay unchanged);
   * localized pages pass their locale, which switches `<html lang>`, the
   * UI strings, the footer links, and the RSS autodiscovery link.
   */
  lang?: Locale;
  /**
   * Nav items; defaults to the root `NAV_ITEMS`. Language pages pass
   * `buildLocalizedNavItems(...)`, the root pages a reduced list.
   */
  navItems?: NavItem[];
  /**
   * The published language versions of this page, rendered twice from the
   * same data: as the hreflang cluster (absolute URLs) and as the visible
   * language switcher (relative URLs). Empty for the shared root pages,
   * which are not part of a language cluster, so no switcher renders.
   */
  alternates?: LocalePathSuffix[];
}

const {
  title,
  description,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  lang,
  navItems,
  alternates = [],
} = Astro.props;

const locale = lang ?? 'en';
const dict = getUiDictionary(locale);
const items = navItems ?? buildNavItems(Astro.url.pathname);

const pageTitle = buildPageTitle(title);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const ogMetadata = buildOgMetadata({
  pageTitle,
  description,
  ogType,
  canonicalUrl: canonicalUrl.href,
  publishedTime,
  modifiedTime,
});

const noindex = isNoindexPagePath(Astro.url.pathname);
const rssHref = lang ? `/${lang}/rss.xml` : '/rss.xml';
const footerArticlesHref = lang ? `/${lang}/articles/` : '/articles/';
const footerRssHref = lang ? `/${lang}/rss.xml` : '/rss.xml';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_NAME}
      href={rssHref}
    />
    {
      alternates.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate.locale}
          href={new URL(getRelativeLocaleUrl(alternate.locale, alternate.pathSuffix), Astro.site).href}
        />
      ))
    }
    {Object.entries(ogMetadata).map(([property, content]) => <meta property={property} content={content} />)}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#main">{dict.skipToContent}</a>
    <header class="site-header">
      <nav aria-label={dict.mainNavLabel}>
        <ul>
          {
            items.map((item) => (
              <li>
                <a href={item.href} aria-current={item.isCurrent ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      {lang && alternates.length > 0 && <LanguageSwitcher links={alternates} currentLocale={lang} />}
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>© 2026 {SITE_NAME}. <a href={footerArticlesHref}>{dict.footerArticles}</a> · <a href={footerRssHref}>{dict.footerRss}</a> · <a href="/impressum/">{dict.footerImpressum}</a> · <a href="/datenschutz/">{dict.footerDatenschutz}</a></p>
    </footer>
  </body>
</html>
