---
/**
 * Bordered surface card for content groupings. Hover only changes border
 * and shadow (cards never move). Colors, radii, shadows, and motion come
 * exclusively from the design tokens.
 */
interface Props {
  /** Optional monospace caption rendered below the content. */
  caption?: string;
}

const { caption } = Astro.props;
---

<div class="content-card">
  <slot />
  {caption && <p class="content-card__caption">{caption}</p>}
</div>

<style>
  .content-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: var(--spacing-2);
    transition:
      border-color var(--transition-slow),
      box-shadow var(--transition-slow);
  }

  .content-card:hover {
    border-color: var(--color-border-active);
    box-shadow: var(--glow-accent);
  }

  .content-card__caption {
    margin-block: var(--spacing-1) 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 1px;
    color: var(--color-signal);
  }

  @media (prefers-reduced-motion: reduce) {
    .content-card {
      transition: none;
    }
  }
</style>
