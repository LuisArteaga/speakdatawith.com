---
import { Image } from 'astro:assets';
import { buildYouTubeWatchUrl } from '../utils/video';
import { getUiDictionary, type Locale } from '../i18n/config';

interface Props {
  videoId: string;
  title: string;
  poster: ImageMetadata;
  locale: Locale;
}

const { videoId, title, poster, locale } = Astro.props;
const strings = getUiDictionary(locale);

// Render-time validation: the builder throws for malformed IDs, so a
// content file with a broken videoId fails the build instead of shipping
// a dead fallback link.
const watchUrl = buildYouTubeWatchUrl(videoId);
---

<div class="youtube-facade">
  <button
    type="button"
    class="youtube-facade__trigger"
    data-video-id={videoId}
    data-video-title={title}
  >
    <Image src={poster} alt="" loading="lazy" decoding="async" />
    <span class="youtube-facade__play" aria-hidden="true">
      <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M32 8a24 24 0 1 1 0 48 24 24 0 0 1 0-48Zm-6 14.5v19L44 32Z"
          fill="currentColor"
          fill-rule="evenodd"
        ></path>
      </svg>
    </span>
    <span class="youtube-facade__hint">
      {strings.youtubeHint}
    </span>
  </button>
  <a
    class="youtube-facade__fallback"
    href={watchUrl}
    target="_blank"
    rel="noopener noreferrer"
  >
    {strings.youtubeFallback}
  </a>
</div>

<script>
  // Click-to-load: no iframe exists until the user activates the facade.
  import { buildYouTubeEmbedAttributes, isValidYouTubeVideoId } from '../utils/video';

  function activateFacade(button: HTMLButtonElement): void {
    const videoId = button.dataset.videoId ?? '';
    const videoTitle = button.dataset.videoTitle ?? 'YouTube video';

    if (!isValidYouTubeVideoId(videoId)) {
      return;
    }

    const container = button.closest('.youtube-facade');
    if (!container) {
      return;
    }

    const embed = document.createElement('div');
    embed.className = 'youtube-facade__embed';

    const iframe = document.createElement('iframe');
    Object.assign(iframe, buildYouTubeEmbedAttributes(videoId, videoTitle));

    embed.append(iframe);
    container.replaceChildren(embed);
  }

  function initYouTubeFacades(): void {
    document
      .querySelectorAll<HTMLButtonElement>('.youtube-facade__trigger')
      .forEach((button) => {
        if (button.dataset.youtubeFacadeBound === 'true') {
          return;
        }
        button.dataset.youtubeFacadeBound = 'true';
        button.addEventListener('click', () => activateFacade(button));
      });
  }

  initYouTubeFacades();
</script>
