---
/**
 * Landing hero: a text column (optional badge, h1 title, optional
 * description, up to two CTAs) and a visual column. The visual column
 * defaults to the interactive owl inside a ContentCard; a `visual` slot
 * replaces it entirely, so later media (e.g. 3D) can be dropped in
 * without touching this component.
 *
 * `ctaText`/`ctaHref` and `secondaryText`/`secondaryHref` are only valid
 * as pairs: when one half is missing, that button does not render.
 */
import Badge from './Badge.astro';
import BrandOwl from './BrandOwl.astro';
import Button from './Button.astro';
import ContentCard from './ContentCard.astro';

interface Props {
  /** Optional text for a Badge (rendered with its glowing dot). */
  badge?: string;
  /** H1 heading text; the page must not contain a second h1. */
  title: string;
  /** Optional excerpt below the title. */
  description?: string;
  /** Primary CTA label; rendered only together with `ctaHref`. */
  ctaText?: string;
  /** Primary CTA target; rendered only together with `ctaText`. */
  ctaHref?: string;
  /** Secondary (ghost) action label; rendered only together with `secondaryHref`. */
  secondaryText?: string;
  /** Secondary (ghost) action target; rendered only together with `secondaryText`. */
  secondaryHref?: string;
}

const { badge, title, description, ctaText, ctaHref, secondaryText, secondaryHref } =
  Astro.props;
const hasPrimaryCta = Boolean(ctaText && ctaHref);
const hasSecondaryCta = Boolean(secondaryText && secondaryHref);
const hasActions = hasPrimaryCta || hasSecondaryCta;
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero__copy">
    {badge && <Badge>{badge}</Badge>}
    <h1 class="hero__title" id="hero-heading">{title}</h1>
    {description && <p class="hero__description">{description}</p>}
    {
      hasActions && (
        <div class="hero__actions">
          {hasPrimaryCta && <Button href={ctaHref}>{ctaText}</Button>}
          {hasSecondaryCta && (
            <Button href={secondaryHref} variant="ghost">
              {secondaryText}
            </Button>
          )}
        </div>
      )
    }
  </div>
  <div class="hero__visual">
    <slot name="visual">
      <div class="owl-interactive">
        <ContentCard caption="[SYSTEM.OWL_INTELLIGENCE_ACTIVE]">
          <BrandOwl size={180} />
        </ContentCard>
      </div>
    </slot>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-4);
    max-width: var(--content-width-wide);
    margin-inline: auto;
    margin-block-end: var(--spacing-3);
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-2);
  }

  .hero__title {
    margin-block: 0;
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .hero__description {
    margin-block: 0;
    max-width: 600px;
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
  }

  .hero__visual {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: center;
    }

    .hero__title {
      font-size: 3.2rem;
    }
  }
</style>
