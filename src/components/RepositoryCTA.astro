---
import { getUiDictionary, type Locale } from '../i18n/config';

interface Props {
  url: string;
  locale: Locale;
  /** Article-content override for the default, localized link text. */
  label?: string;
}

const { url, locale, label } = Astro.props;
const text = label ?? getUiDictionary(locale).viewRepository;
---

<p class="repository-cta">
  <a href={url} rel="noopener noreferrer">{text}</a>
</p>
