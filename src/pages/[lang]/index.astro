---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/Badge.astro';
import ContentCard from '../../components/ContentCard.astro';
import Hero from '../../components/Hero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { getCollection } from 'astro:content';
import { getPublishedArticles } from '../../utils/articles';
import { buildIndexAlternates } from '../../utils/alternates';
import { buildLocalizedNavItems } from '../../utils/navigation';
import { formatArticleDate } from '../../utils/dates';
import { LOCALES, getUiDictionary, type Locale } from '../../i18n/config';

export function getStaticPaths() {
  // Imported bindings (LOCALES) are available inside getStaticPaths; only
  // same-file declarations are out of scope, because Astro hoists the route
  // function above the frontmatter. The locale therefore comes from the
  // route params, which getStaticPaths itself restricts to LOCALES.
  return LOCALES.map((locale) => ({ params: { lang: locale } }));
}

const locale = Astro.params.lang as Locale;
const dict = getUiDictionary(locale);

const allArticles = await getCollection('articles');
const latestArticles = getPublishedArticles(allArticles, locale).slice(0, 3);
const navItems = buildLocalizedNavItems(locale, Astro.url.pathname);
const alternates = buildIndexAlternates(Astro.url.pathname);
---

<BaseLayout
  title="SpeakDataWith"
  description={dict.homeDescription}
  lang={locale}
  navItems={navItems}
  alternates={alternates}
  wide
>
  <Hero
    title="SpeakDataWith"
    description={dict.homeIntro}
    ctaText={dict.homeBrowseAll}
    ctaHref={`/${locale}/articles/`}
  />

  <section aria-labelledby="latest-articles-heading">
    <SectionHeading id="latest-articles-heading" title={dict.homeLatest} />
    {
      latestArticles.length === 0 ? (
        <p>{dict.homeEmpty}</p>
      ) : (
        <ul class="article-list">
          {latestArticles.map((article) => (
            <li>
              <ContentCard>
                <p class="article-list__title">
                  <a href={`/${locale}/articles/${article.id}/`}>{article.data.title}</a>
                </p>
                <Badge>{formatArticleDate(article.data.publishedAt, locale)}</Badge>
                <p>{article.data.description}</p>
                <p class="article-list__read-more">
                  <a href={`/${locale}/articles/${article.id}/`}>{dict.readArticle}</a>
                </p>
              </ContentCard>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
