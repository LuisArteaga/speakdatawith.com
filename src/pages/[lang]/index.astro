---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandOwl from '../../components/BrandOwl.astro';
import Badge from '../../components/Badge.astro';
import Button from '../../components/Button.astro';
import ContentCard from '../../components/ContentCard.astro';
import { getCollection } from 'astro:content';
import { getPublishedArticles } from '../../utils/articles';
import { buildIndexAlternates } from '../../utils/alternates';
import { buildLocalizedNavItems } from '../../utils/navigation';
import { formatArticleDate } from '../../utils/dates';
import { LOCALES, getUiDictionary, type Locale } from '../../i18n/config';

export function getStaticPaths() {
  // Imported bindings (LOCALES) are available inside getStaticPaths; only
  // same-file declarations are out of scope, because Astro hoists the route
  // function above the frontmatter. The locale therefore comes from the
  // route params, which getStaticPaths itself restricts to LOCALES.
  return LOCALES.map((locale) => ({ params: { lang: locale } }));
}

const locale = Astro.params.lang as Locale;
const dict = getUiDictionary(locale);

const allArticles = await getCollection('articles');
const latestArticles = getPublishedArticles(allArticles, locale).slice(0, 3);
const navItems = buildLocalizedNavItems(locale, Astro.url.pathname);
const alternates = buildIndexAlternates(Astro.url.pathname);
---

<BaseLayout
  title="SpeakDataWith"
  description={dict.homeDescription}
  lang={locale}
  navItems={navItems}
  alternates={alternates}
>
  <section class="intro">
    <div class="intro__copy">
      <h1>SpeakDataWith</h1>
      <p>{dict.homeIntro}</p>
      <Button href={`/${locale}/articles/`}>{dict.homeBrowseAll}</Button>
    </div>
    <div class="intro__owl owl-interactive">
      <ContentCard>
        <BrandOwl size={180} />
      </ContentCard>
    </div>
  </section>

  <section aria-labelledby="latest-articles-heading">
    <h2 id="latest-articles-heading">{dict.homeLatest}</h2>
    {
      latestArticles.length === 0 ? (
        <p>{dict.homeEmpty}</p>
      ) : (
        <ul class="article-list">
          {latestArticles.map((article) => (
            <li>
              <ContentCard>
                <p class="article-list__title">
                  <a href={`/${locale}/articles/${article.id}/`}>{article.data.title}</a>
                </p>
                <Badge>{formatArticleDate(article.data.publishedAt, locale)}</Badge>
                <p>{article.data.description}</p>
                <p class="article-list__read-more">
                  <a href={`/${locale}/articles/${article.id}/`}>{dict.readArticle}</a>
                </p>
              </ContentCard>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>

<style>
  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-3);
    margin-block-end: var(--spacing-3);
  }

  .intro__copy {
    flex: 1 1 20rem;
  }

  .intro__copy h1 {
    margin-block: 0 var(--spacing-1);
    font-size: clamp(2rem, 5vw, 2.75rem);
    letter-spacing: -0.02em;
  }

  .intro__copy p {
    margin-block: 0 var(--spacing-2);
  }

  .intro__owl {
    flex: 0 1 auto;
  }

  .article-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .article-list li {
    margin-block-end: var(--spacing-2);
  }

  .article-list__title {
    margin-block: 0 var(--spacing-1);
    font-size: 1.15rem;
    font-weight: 600;
  }

  .article-list__read-more {
    margin-block: var(--spacing-1) 0;
    font-size: 0.9rem;
  }
</style>
