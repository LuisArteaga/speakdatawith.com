---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import {
  getPublishedArticles,
  groupPublishedByTranslationKey,
  type Article,
  type PublishedLanguageVersions,
} from '../../../utils/articles';
import { buildArticleAlternates } from '../../../utils/alternates';
import { buildLocalizedNavItems } from '../../../utils/navigation';
import { LOCALES, type Locale } from '../../../i18n/config';

export async function getStaticPaths() {
  // Drafts, unreviewed translations, stale translations (stored or derived),
  // and future-dated articles are excluded here, so no public page is ever
  // generated for them. Imported bindings (LOCALES and the helpers) are
  // available inside getStaticPaths; only same-file declarations are out of
  // scope, because Astro hoists the route function above the frontmatter.
  const allArticles = await getCollection('articles');
  const publishedGroups = groupPublishedByTranslationKey(allArticles);
  return LOCALES.flatMap((locale) =>
    getPublishedArticles(allArticles, locale).map((article) => ({
      params: { lang: locale, slug: article.id },
      props: {
        article,
        versions: publishedGroups.get(article.data.translationKey),
      },
    })),
  );
}

interface Props {
  article: Article;
  versions?: PublishedLanguageVersions;
}

const { article, versions } = Astro.props;
const { Content } = await render(article);

const locale = Astro.params.lang as Locale;
const navItems = buildLocalizedNavItems(locale, Astro.url.pathname);
const alternates = buildArticleAlternates(article, versions);
---

<ArticleLayout
  article={article}
  locale={locale}
  navItems={navItems}
  alternates={alternates}
>
  <Content />
</ArticleLayout>
