---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContentCard from '../../../components/ContentCard.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import { getCollection } from 'astro:content';
import { getPublishedArticles } from '../../../utils/articles';
import { buildIndexAlternates } from '../../../utils/alternates';
import { buildLocalizedNavItems } from '../../../utils/navigation';
import { formatArticleDate } from '../../../utils/dates';
import { LOCALES, getUiDictionary, type Locale } from '../../../i18n/config';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { lang: locale } }));
}

const locale = Astro.params.lang as Locale;
const dict = getUiDictionary(locale);

const allArticles = await getCollection('articles');
const articles = getPublishedArticles(allArticles, locale);
const navItems = buildLocalizedNavItems(locale, Astro.url.pathname);
const alternates = buildIndexAlternates(Astro.url.pathname);
---

<BaseLayout
  title={dict.articlesHeading}
  description={dict.articlesDescription}
  lang={locale}
  navItems={navItems}
  alternates={alternates}
>
  <h1>{dict.articlesHeading}</h1>
  <section aria-labelledby="articles-list-heading">
    <SectionHeading id="articles-list-heading" title={dict.articlesListHeading} />
    {
      articles.length === 0 ? (
        <p>{dict.articlesEmpty}</p>
      ) : (
        <ul class="article-list">
          {articles.map((article) => (
            <li>
              <ContentCard>
                <p class="article-list__title">
                  <a href={`/${locale}/articles/${article.id}/`}>{article.data.title}</a>
                </p>
                <p class="article-meta">
                  <time datetime={article.data.publishedAt.toISOString()}>
                    {formatArticleDate(article.data.publishedAt, locale)}
                  </time>
                  {article.data.pillar.length > 0 && (
                    <span>
                      {' · '}
                      {article.data.pillar.map((pillar) => (
                        <span class="pillar">{pillar}</span>
                      ))}
                    </span>
                  )}
                </p>
                <p>{article.data.description}</p>
                <p class="article-list__read-more">
                  <a href={`/${locale}/articles/${article.id}/`}>{dict.readArticle}</a>
                </p>
              </ContentCard>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
