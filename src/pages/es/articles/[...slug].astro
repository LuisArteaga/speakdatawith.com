---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import {
  getPublishedArticles,
  groupPublishedByTranslationKey,
  type Article,
  type PublishedLanguageVersions,
} from '../../../utils/articles';
import { buildArticleAlternates } from '../../../utils/alternates';
import { buildLocalizedNavItems } from '../../../utils/navigation';

const locale = 'es' as const;

export async function getStaticPaths() {
  // Self-contained: Astro hoists getStaticPaths out of the page module, so
  // it cannot reference frontmatter variables — the locale is declared here.
  const locale = 'es' as const;
  // Drafts, unreviewed translations, stale translations (stored or derived),
  // and future-dated articles are excluded here, so no public page is ever
  // generated for them.
  const allArticles = await getCollection('articles');
  const publishedGroups = groupPublishedByTranslationKey(allArticles);
  const publishedArticles = getPublishedArticles(allArticles, locale);
  return publishedArticles.map((article) => ({
    params: { slug: article.id },
    props: {
      article,
      versions: publishedGroups.get(article.data.translationKey),
    },
  }));
}

interface Props {
  article: Article;
  versions?: PublishedLanguageVersions;
}

const { article, versions } = Astro.props;
const { Content } = await render(article);

const navItems = buildLocalizedNavItems(locale, Astro.url.pathname);
const languageLinks = buildArticleAlternates(article, versions);
---

<ArticleLayout
  article={article}
  locale={locale}
  navItems={navItems}
  alternates={languageLinks}
  languageSwitcher={languageLinks}
>
  <Content />
</ArticleLayout>
