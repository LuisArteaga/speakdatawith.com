---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildRootNavItems } from '../utils/navigation';

const navItems = buildRootNavItems('en', Astro.url.pathname);
---

<BaseLayout
  title="About"
  description="About this website."
  lang="en"
  navItems={navItems}
>
  <h1>About</h1>
  <p>
    This page is a technical placeholder. It will be replaced with editorial
    content later.
  </p>
  <p>
    The site is statically generated with Astro. It uses no client-side
    framework, no external fonts or scripts, and no third-party analytics.
  </p>
</BaseLayout>
